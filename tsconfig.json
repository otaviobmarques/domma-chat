{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["apps/api/src/**/*.ts", "packages/core/src/**/*.ts", "packages/*/src/**/*.ts", "apps/api/src/**/*.ts", "apps/workers/src/**/*.ts"]
}
