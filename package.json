{
  "name": "domma-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:seed": "tsx packages/db/src/seed.ts",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:workers": "tsx watch apps/workers/src/index.ts",
    "dev:web": "npm run dev -w @domma/web",
    "start:api": "tsx apps/api/src/index.ts",
    "start:workers": "tsx apps/workers/src/index.ts",
    "build:web": "npm run build -w @domma/web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test packages/*/src/**/*.test.ts apps/*/src/**/*.test.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
