# Banco e filas
DATABASE_URL=postgres://domma:domma@localhost:5432/domma
REDIS_URL=redis://localhost:6379
# Endereços públicos
APP_URL=http://localhost:5173
API_URL=http://localhost:3333
PORT=3333
# Segurança (troque em produção!)
JWT_SECRET=troque-por-um-segredo-longo
ENCRYPTION_KEY=troque-por-outra-chave-longa
# WhatsApp Cloud API (Meta)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
# Evolution API (QR Code)
EVOLUTION_URL=http://localhost:8080
EVOLUTION_GLOBAL_KEY=
# Armazenamento S3/R2 (vazio = disco local em ./armazenamento)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Notificações push (gere com: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@domma.com.br
# Google Agenda
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Opcional: chave usada só pelo seed para cadastrar Claude como IA principal
ANTHROPIC_API_KEY=
# Ajustes
IA_TEMPO_LIMITE_MS=12000
WORKER_GRUPO=todos
